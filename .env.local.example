# Reference for the two public Supabase values, from your Supabase dashboard
# (Project Settings -> API Keys). Set them in .env.local or .env — either file
# works, .env.local wins where both define the same key.
#
# If you copy this file, delete the lines you are not filling in: an empty value
# in .env.local counts as "defined" and shadows a working value in .env, which
# leaves the app silently unconfigured.
#
# Either a new-scheme publishable key (sb_publishable_...) or a legacy anon key
# (eyJ...) works as the value. NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as
# a fallback variable name for older setups.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
